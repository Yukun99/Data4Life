# Copy to .env (gitignored). Docker Compose reads all of it; a local backend run reads the ADMIN_* lines.
POSTGRES_DB=data4life
POSTGRES_USER=data4life
POSTGRES_PASSWORD=change-me
# Email of the account that becomes admin (on sign-up, or at startup if it already exists).
ADMIN_EMAIL=
# Optional. When set, the admin account is created at startup with this password if it does not
# exist yet (8 to 32 characters, no spaces). An existing account keeps its password.
ADMIN_PASSWORD=
